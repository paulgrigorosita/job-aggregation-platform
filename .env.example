# Database
DATABASE_URL=postgresql://jap:secret@localhost:5432/jap

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

