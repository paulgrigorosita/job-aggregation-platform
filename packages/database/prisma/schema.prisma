generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?
  logoUrl   String?
  atsType   String?  // greenhouse | lever | ashby | null
  atsSlug   String?  // slug used in the ATS API URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]

  @@index([slug])
  @@index([atsType])
  @@map("companies")
}

model Job {
  id             String    @id @default(cuid())
  urlHash        String    @unique
  applyUrl       String
  title          String
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  location       String?
  remote         Boolean   @default(false)
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?   @default("USD")
  salaryPeriod   String?
  description    String?   @db.Text
  postedAt       DateTime?
  source         String
  aiScore        Int       @default(0)
  isAI           Boolean   @default(false)
  isFullStack    Boolean   @default(false)
  isBackend      Boolean   @default(false)
  isFrontend     Boolean   @default(false)
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  isActive       Boolean   @default(true)
  fitScore       Int?      // 0-100 resume fit score from Claude (null = not yet ranked)
  fitReason      String?   @db.Text // brief explanation from Claude
  tailoredResume Json?     // Claude-generated tailored resume JSON for this job
  tags           JobTag[]

  @@index([source])
  @@index([remote])
  @@index([isAI])
  @@index([postedAt])
  @@index([aiScore])
  @@index([companyId])
  @@map("jobs")
}

model JobTag {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag   String

  @@unique([jobId, tag])
  @@index([tag])
  @@map("job_tags")
}

model Resume {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  linkedinUrl String?
  githubUrl   String?
  title       String   // base title e.g. "Full-Stack Engineer"
  summary     String   @db.Text
  skills      Json     // string[]
  workHistory Json     // WorkEntry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("resumes")
}

model ScraperRun {
  id           String    @id @default(cuid())
  source       String
  status       String
  jobsFetched  Int       @default(0)
  jobsNew      Int       @default(0)
  jobsDupe     Int       @default(0)
  jobsRejected Int       @default(0)
  errors       Json?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?

  @@index([source])
  @@index([startedAt])
  @@map("scraper_runs")
}
