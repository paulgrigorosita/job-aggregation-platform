{
  "name": "@jap/shared",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --dts --format cjs --out-dir dist --external pino --external pino-pretty --external got-scraping --external date-fns",
