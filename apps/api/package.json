{
  "name": "@jap/api",
  "version": "0.1.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsup src/server.ts src/app.ts --format cjs --out-dir dist",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@jap/database": "workspace:*",
    "@jap/shared": "workspace:*",
    "dotenv": "^16.4.0",
    "fast-xml-parser": "^4.4.0",
    "fastify": "^4.28.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
