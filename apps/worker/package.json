{
  "name": "@jap/worker",
  "version": "0.1.0",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --out-dir dist",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests in worker\" && exit 0"
  },
  "dependencies": {
    "@jap/shared": "workspace:*",
    "@jap/database": "workspace:*",
    "@jap/scrapers": "workspace:*",
    "bullmq": "^5.8.0",
    "ioredis": "^5.3.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.15.0",
    "@types/node": "^20.0.0"
  }
}
